[Unit]
Description=CloudPulse Alerts Service
After=network.target

[Service]
User=ubuntu
Environment=GRAFANA_TOKEN=REPLACE_ME
Environment=GMAIL_USER=REPLACE_ME
Environment=GMAIL_PASS=REPLACE_ME
ExecStart=/usr/bin/node /opt/cloudpulse/services/monitoring/server.mjs
Restart=always

[Install]
WantedBy=multi-user.target
