# Shell scripts and configs consumed inside Linux containers must stay LF,
# regardless of core.autocrlf on Windows checkouts.
*.sh            text eol=lf
*.envsh         text eol=lf
*.template      text eol=lf
Dockerfile*     text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
docker-compose.yml text eol=lf
